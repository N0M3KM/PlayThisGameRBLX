{
  "name": "Play This Game Foundation",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": "Packages"
      },
      "Controllers": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "Configs": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "MatchPreviewMode": {
        "$className": "BoolValue",
        "$properties": {
          "Value": false
        }
      },
      "MatchPreviewTemplate": {
        "$path": "assets/UI/MatchPreview.model.json"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "FoundationClient": {
          "$path": "tools/studio/FoundationClient.client.luau"
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "ServerPackages": {
        "$path": "ServerPackages"
      },
      "Services": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "FoundationHarness": {
        "$path": "tools/studio/FoundationHarness.server.luau"
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "Assets": {
        "$className": "Folder",
        "Lobby": {
          "$path": "assets/Lobby"
        },
        "Maps": {
          "$path": "assets/Maps"
        }
      }
    }
  }
}
