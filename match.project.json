{
  "name": "Play This Game Match Preview",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "MatchPreviewMode": {
        "$properties": {
          "Value": true
        },
        "$className": "BoolValue"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "ServerStorage": {
      "Assets": {
        "$className": "Folder",
        "Lobby": {
          "$path": "assets/Lobby"
        },
        "Maps": {
          "$path": "assets/Maps"
        }
      },
      "$className": "ServerStorage"
    },
    "StarterGui": {
      "$ignoreUnknownInstances": true,
      "MatchPreview": {
        "$path": "assets/UI/MatchPreview.model.json"
      },
      "$className": "StarterGui"
    }
  }
}
